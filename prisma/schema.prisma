// WorkHub — unified employee & operations management platform
// SQLite schema for: employees, timesheets, leave, complaints, loans, fleet, reports, sheets

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id          String   @id @default(cuid())
  employeeNo  String   @unique
  name        String
  email       String   @unique
  phone       String?
  position    String
  department  String
  hireDate    DateTime
  salary      Float
  status      String   @default("active") // active | on-leave | suspended | terminated
  avatar      String?
  pin         String   @default("0000") // employee-app portal access code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timesheets     Timesheet[]
  leaves         LeaveRequest[]
  complaints     Complaint[]
  loans          Loan[]
  fleetLogs      FleetLog[]
  inspections    VehicleInspection[]  @relation("InspectionInspector")
  services       ServiceRecord[]      @relation("ServiceMechanic")
  reports        WeeklyReport[]       @relation("ReportAuthor")
  payslips       Payslip[]
  portalSessions PortalSession[]
  warnings       Warning[]
}

model Timesheet {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  clockIn    DateTime
  clockOut   DateTime?
  breakMin   Int      @default(30)
  hours      Float    @default(0)
  status     String   @default("pending") // pending | approved | rejected
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  type       String   // annual | sick | unpaid | maternity | emergency
  startDate  DateTime
  endDate    DateTime
  days       Float
  reason     String
  status     String   @default("pending") // pending | approved | rejected
  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String    @id @default(cuid())
  employeeId  String
  title       String
  description String
  category    String    // harassment | safety | payment | workload | equipment | other
  priority    String    @default("medium") // low | medium | high | critical
  status      String    @default("open") // open | investigating | resolved | dismissed
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Loan {
  id              String   @id @default(cuid())
  employeeId      String
  principal       Float
  interestRate    Float    @default(0)
  termMonths      Int
  monthlyPayment  Float
  balance         Float
  status          String   @default("active") // active | paid | defaulted
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                  String   @id @default(cuid())
  plateNumber         String   @unique
  brand               String
  model               String
  year                Int
  type                String   // car | van | truck | motorcycle
  status              String   @default("active") // active | maintenance | retired
  assignedTo          String?  // employee name or null for pool
  mileage             Int      @default(0)
  fuelLevel           Int      @default(100)

  // Purchase & registration data
  vin                 String?
  purchasePrice       Float?
  purchaseDate        DateTime?
  supplier            String?  // dealership or seller
  color               String?
  insuranceExpiry     DateTime?
  registrationExpiry  DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  logs                FleetLog[]
  inspections         VehicleInspection[]
  services            ServiceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
}

model FleetLog {
  id           String   @id @default(cuid())
  vehicleId    String
  employeeId   String?
  date         DateTime
  startOdometer Int
  endOdometer  Int
  distance     Int
  fuelCost     Float    @default(0)
  purpose      String
  createdAt    DateTime @default(now())

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee     Employee? @relation(fields: [employeeId], references: [id])
}

// Weekly driver inspection of a vehicle.
// If any checklist item is "warning" or "fail", the inspection is flagged
// and a notification is surfaced to the fleet controller.
model VehicleInspection {
  id            String   @id @default(cuid())
  vehicleId     String
  inspectorId   String?  // employee who performed inspection (the driver)
  date          DateTime
  overallStatus String   @default("pass") // pass | warning | fail
  flagged       Boolean  @default(false)
  acknowledgedBy String? // fleet controller who acknowledged the flag
  acknowledgedAt DateTime?
  items         String   // JSON: [{id, name, status: "ok"|"warning"|"fail", notes}]
  notes         String?
  odoReading    Int?
  createdAt     DateTime @default(now())

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspector     Employee? @relation("InspectionInspector", fields: [inspectorId], references: [id])
}

// Service & repair log — every oil change, wheel rotation, brake job, part replacement.
model ServiceRecord {
  id             String   @id @default(cuid())
  vehicleId      String
  type           String   // oil-change | wheel-rotation | tire-replacement | brake-service | battery | filter | inspection | repair | other
  description    String
  date           DateTime
  mileage        Int
  cost           Float    @default(0)
  performedById  String?  // mechanic / employee
  supplier       String?  // workshop / parts supplier
  partsReplaced  String   // JSON: [{name, qty, cost}]
  notes          String?
  createdAt      DateTime @default(now())

  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  performedBy    Employee? @relation("ServiceMechanic", fields: [performedById], references: [id])
}

// Recurring maintenance schedule — wheel rotation, oil change, brake check, etc.
// Generates "due now" / "overdue" notifications.
model MaintenanceSchedule {
  id                   String    @id @default(cuid())
  vehicleId            String
  task                 String    // e.g. "Wheel rotation", "Oil change", "Brake inspection"
  intervalType         String    // mileage | time | both
  intervalMileage      Int?      // every N km
  intervalDays         Int?      // every N days
  lastPerformedDate    DateTime?
  lastPerformedMileage Int?
  nextDueDate          DateTime?
  nextDueMileage       Int?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vehicle              Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// Daily Factory Report — multi-site operational report (e.g. BAYWASH CLEANING).
// Sections + items are JSON-encoded for flexibility (matches the document nature of these reports).
//
// sections: [{
//   id, siteName, reporterName, summary,
//   items: [{ id, category, description, actionNeeded, responsiblePerson, status }]
// }]
//
// category: cleaning-findings | machinery | personnel | ppe-equipment | other
// status:   open | in-progress | resolved
model FactoryReport {
  id           String   @id @default(cuid())
  reportDate   DateTime
  company      String
  frequency    String   @default("DAILY") // DAILY | WEEKLY | MONTHLY
  compiledBy   String
  compiledFor  String?
  title        String
  sections     String   // JSON
  status       String   @default("submitted") // draft | submitted | reviewed
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WeeklyReport {
  id                String   @id @default(cuid())
  weekStart         DateTime
  weekEnd           DateTime
  title             String
  summary           String
  totalEmployees    Int
  totalHours        Float
  complaintsOpen    Int
  complaintsResolved Int
  leaveDays         Float
  fleetTrips        Int
  fleetDistance     Int
  loansActive       Int
  authoredById      String?
  createdAt         DateTime @default(now())

  authoredBy        Employee? @relation("ReportAuthor", fields: [authoredById], references: [id])
}

model Sheet {
  id          String   @id @default(cuid())
  name        String
  description String?
  columns     String   // JSON-encoded array of {id, name, type}
  rows        String   // JSON-encoded array of row objects keyed by column id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Monthly payslip issued by payroll — visible to the employee in the Employee App.
// items: JSON [{ label, amount, kind: "earning" | "deduction" }]
model Payslip {
  id           String   @id @default(cuid())
  employeeId   String
  month        Int      // 1-12
  year         Int
  periodLabel  String   // e.g. "November 2026"
  baseSalary   Float
  gross        Float
  deductions   Float
  net          Float
  hours        Float    @default(0)
  items        String   // JSON earnings/deductions breakdown
  notes        String?
  status       String   @default("issued") // draft | issued
  issuedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model FormSubmission {
  id        String   @id @default(cuid())
  template  String   // "incident-report" | "accident-report" | "customer-complaint" | "customer-notification" | "leave-application"
  data      String   // JSON-encoded field values keyed by field key
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Server-side session for the Employee App — the portal client presents this
// token as `Authorization: Bearer <token>`; all portal data is scoped to it.
model PortalSession {
  id         String   @id @default(cuid())
  token      String   @unique
  employeeId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Disciplinary / performance warnings issued to an employee by a manager.
// Visible to the employee on their portal (read-only, with acknowledge action).
model Warning {
  id             String    @id @default(cuid())
  employeeId     String
  type           String    // verbal | written | final | performance | safety
  subject        String
  details        String
  issuedBy       String    // manager name or email
  issuedAt       DateTime
  status         String    @default("active") // active | acknowledged | expired | withdrawn
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
